<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{COUNTRY_NAME}} - Souvenirs de voyage</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            overflow: hidden;
        }

        /* Password Protection Overlay */
        #password-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            animation: fadeIn 0.5s ease;
        }

        #password-overlay.hidden {
            display: none;
        }

        .password-container {
            background: rgba(255, 255, 255, 0.95);
            padding: 50px 40px;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            text-align: center;
            max-width: 400px;
            width: 90%;
            animation: slideUp 0.5s ease;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .password-container h2 {
            color: #764ba2;
            margin-bottom: 10px;
            font-size: 2em;
        }

        .password-container p {
            color: #666;
            margin-bottom: 30px;
            font-size: 1em;
        }

        .password-input-group {
            position: relative;
            margin-bottom: 20px;
        }

        .password-input-group input {
            width: 100%;
            padding: 15px 20px;
            border: 2px solid #ddd;
            border-radius: 10px;
            font-size: 16px;
            transition: all 0.3s ease;
            outline: none;
        }

        .password-input-group input:focus {
            border-color: #764ba2;
            box-shadow: 0 0 0 3px rgba(118, 75, 162, 0.1);
        }

        .password-submit {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .password-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(118, 75, 162, 0.4);
        }

        .password-submit:active {
            transform: translateY(0);
        }

        .error-message {
            color: #e74c3c;
            margin-top: 15px;
            font-size: 14px;
            display: none;
            animation: shake 0.5s ease;
        }

        .error-message.show {
            display: block;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            75% { transform: translateX(10px); }
        }

        /* Gallery Content */
        #gallery-content {
            display: none;
            width: 100%;
            height: 100vh;
        }

        #gallery-content.visible {
            display: block;
        }

        .container {
            max-width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
            position: relative;
        }

        .back-button {
            position: fixed;
            top: 20px;
            left: 20px;
            padding: 12px 24px;
            background: rgba(255, 255, 255, 0.95);
            color: #764ba2;
            text-decoration: none;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            transition: all 0.3s ease;
            font-size: 16px;
            font-weight: 600;
            z-index: 100;
            backdrop-filter: blur(10px);
        }

        .back-button:hover {
            background: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
        }

        /* Fullscreen Carousel */
        .carousel {
            position: relative;
            width: 100%;
            height: 100vh;
            overflow: hidden;
            background: #000;
        }

        .carousel-inner {
            position: relative;
            width: 100%;
            height: 100%;
            display: flex;
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .carousel-item {
            min-width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }

        .carousel-item img {
            max-width: 100%;
            max-height: 100%;
            width: auto;
            height: auto;
            object-fit: contain;
            user-select: none;
            -webkit-user-drag: none;
        }

        /* Navigation Arrows */
        .carousel-control {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(255, 255, 255, 0.15);
            color: white;
            border: none;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            font-size: 28px;
            cursor: pointer;
            transition: all 0.3s ease;
            z-index: 10;
            backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .carousel-control:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-50%) scale(1.1);
        }

        .carousel-control.prev {
            left: 30px;
        }

        .carousel-control.next {
            right: 30px;
        }

        /* Image Counter */
        .image-counter {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(255, 255, 255, 0.15);
            color: white;
            padding: 12px 24px;
            border-radius: 25px;
            font-size: 16px;
            font-weight: 500;
            z-index: 10;
            backdrop-filter: blur(10px);
        }

        /* Thumbnail Navigation */
        .thumbnail-nav {
            position: fixed;
            bottom: 80px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 10px;
            z-index: 10;
            max-width: 90%;
            overflow-x: auto;
            padding: 10px;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 15px;
            backdrop-filter: blur(10px);
        }

        .thumbnail-nav::-webkit-scrollbar {
            height: 5px;
        }

        .thumbnail-nav::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 5px;
        }

        .thumbnail-nav::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.3);
            border-radius: 5px;
        }

        .thumbnail {
            width: 80px;
            height: 80px;
            border-radius: 10px;
            overflow: hidden;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 3px solid transparent;
            flex-shrink: 0;
        }

        .thumbnail:hover {
            transform: scale(1.1);
            border-color: rgba(255, 255, 255, 0.5);
        }

        .thumbnail.active {
            border-color: white;
            transform: scale(1.15);
        }

        .thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Empty Gallery Message */
        .empty-gallery {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            color: white;
            z-index: 5;
        }

        .empty-gallery h2 {
            font-size: 2em;
            margin-bottom: 10px;
        }

        .empty-gallery p {
            font-size: 1.1em;
            opacity: 0.8;
        }

        /* Loading Animation */
        .loading {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: white;
            font-size: 18px;
        }

        .spinner {
            border: 4px solid rgba(255, 255, 255, 0.3);
            border-top: 4px solid white;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 0 auto 10px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .carousel-control {
                width: 45px;
                height: 45px;
                font-size: 20px;
            }

            .carousel-control.prev {
                left: 15px;
            }

            .carousel-control.next {
                right: 15px;
            }

            .thumbnail {
                width: 60px;
                height: 60px;
            }

            .back-button {
                padding: 10px 18px;
                font-size: 14px;
            }

            .image-counter {
                font-size: 14px;
                padding: 10px 20px;
            }
        }
    </style>
</head>
<body>
    <!-- Password Protection Overlay -->
    <div id="password-overlay">
        <div class="password-container">
            <h2>🔒 {{COUNTRY_EMOJI}} {{COUNTRY_NAME}}</h2>
            <p>Veuillez entrer le mot de passe pour accéder aux souvenirs</p>
            <div class="password-input-group">
                <input type="password" id="password-input" placeholder="Mot de passe" autocomplete="off">
            </div>
            <button class="password-submit" onclick="checkPassword()">Accéder</button>
            <p class="error-message" id="error-message">❌ Mot de passe incorrect</p>
        </div>
    </div>

    <!-- Gallery Content -->
    <div id="gallery-content">
        <div class="container">
            <a class="back-button" href="voyages.html">← Retour</a>
            
            <!-- Fullscreen Carousel -->
            <div class="carousel">
                <div class="carousel-inner" id="carousel-inner">
                    <!-- Les images seront générées dynamiquement par JavaScript -->
                </div>

                <!-- Navigation Controls -->
                <button class="carousel-control prev" onclick="prevSlide()" style="display: none;" id="prev-btn">‹</button>
                <button class="carousel-control next" onclick="nextSlide()" style="display: none;" id="next-btn">›</button>
            </div>

            <!-- Image Counter -->
            <div class="image-counter" id="image-counter" style="display: none;"></div>

            <!-- Thumbnail Navigation -->
            <div class="thumbnail-nav" id="thumbnail-nav" style="display: none;"></div>

            <!-- Empty Gallery Message -->
            <div class="empty-gallery" id="empty-gallery">
                <h2>📁 Pas de photos pour le moment</h2>
                <p>Revenez bientôt pour découvrir les souvenirs de {{COUNTRY_NAME}} !</p>
            </div>
        </div>
    </div>

    <script>
        // Configuration
        const correctPassword = "{{PASSWORD}}";
        const countryName = "{{COUNTRY_NAME}}";
        const imagesFolder = "./VOYAGES/{{COUNTRY_FOLDER}}/";
        
        // Éléments DOM
        const passwordOverlay = document.getElementById('password-overlay');
        const galleryContent = document.getElementById('gallery-content');
        const passwordInput = document.getElementById('password-input');
        const errorMessage = document.getElementById('error-message');
        const carouselInner = document.getElementById('carousel-inner');
        const imageCounter = document.getElementById('image-counter');
        const thumbnailNav = document.getElementById('thumbnail-nav');
        const emptyGallery = document.getElementById('empty-gallery');
        const prevBtn = document.getElementById('prev-btn');
        const nextBtn = document.getElementById('next-btn');

        // Check if user has already entered correct password (session storage)
        if (sessionStorage.getItem(`${countryName}Access`) === 'granted') {
            showGallery();
        }

        // Allow Enter key to submit password
        passwordInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                checkPassword();
            }
        });

        function checkPassword() {
            const enteredPassword = passwordInput.value;
            
            if (enteredPassword === correctPassword) {
                sessionStorage.setItem(`${countryName}Access`, 'granted');
                showGallery();
            } else {
                errorMessage.classList.add('show');
                passwordInput.value = '';
                passwordInput.focus();
                
                setTimeout(() => {
                    errorMessage.classList.remove('show');
                }, 3000);
            }
        }

        function showGallery() {
            passwordOverlay.classList.add('hidden');
            galleryContent.classList.add('visible');
            loadGallery();
        }

        // Carousel Functionality
        let currentSlide = 0;
        let slides = [];
        let totalSlides = 0;

        async function loadGallery() {
            try {
                // Essayer de charger les images depuis le dossier
                // Note: Cette approche nécessite un backend pour lister les fichiers
                // Pour GitHub Pages, nous utiliserons une approche alternative
                
                // Vérifier si des images existent en testant des noms courants
                const imageNames = await detectImages();
                
                if (imageNames.length === 0) {
                    // Pas d'images trouvées
                    emptyGallery.style.display = 'block';
                    return;
                }
                
                // Créer les éléments du carrousel
                imageNames.forEach((imageName, index) => {
                    const item = document.createElement('div');
                    item.className = 'carousel-item';
                    const img = document.createElement('img');
                    img.src = imagesFolder + imageName;
                    img.alt = `Photo ${index + 1}`;
                    img.loading = index === 0 ? 'eager' : 'lazy';
                    item.appendChild(img);
                    carouselInner.appendChild(item);
                    
                    // Créer la miniature
                    const thumb = document.createElement('div');
                    thumb.className = index === 0 ? 'thumbnail active' : 'thumbnail';
                    thumb.onclick = () => goToSlide(index);
                    const thumbImg = document.createElement('img');
                    thumbImg.src = imagesFolder + imageName;
                    thumbImg.alt = `Miniature ${index + 1}`;
                    thumb.appendChild(thumbImg);
                    thumbnailNav.appendChild(thumb);
                });
                
                slides = document.querySelectorAll('.carousel-item');
                totalSlides = slides.length;
                
                // Afficher les contrôles
                emptyGallery.style.display = 'none';
                prevBtn.style.display = 'flex';
                nextBtn.style.display = 'flex';
                imageCounter.style.display = 'block';
                thumbnailNav.style.display = 'flex';
                
                updateCarousel();
            } catch (error) {
                console.error('Erreur lors du chargement de la galerie:', error);
                emptyGallery.style.display = 'block';
            }
        }

        async function detectImages() {
            // Fonction pour détecter les images disponibles
            // Cette fonction essaie de charger des images avec des noms courants
            const imageNames = [];
            const commonFormats = ['jpg', 'jpeg', 'png', 'webp', 'gif'];
            const maxImages = 50;
            
            for (let i = 1; i <= maxImages; i++) {
                for (const format of commonFormats) {
                    const imagePath = imagesFolder + i + '.' + format;
                    try {
                        const response = await fetch(imagePath, { method: 'HEAD' });
                        if (response.ok) {
                            imageNames.push(i + '.' + format);
                            break;
                        }
                    } catch (e) {
                        // Image non trouvée, continuer
                    }
                }
            }
            
            return imageNames;
        }

        function updateCarousel() {
            if (totalSlides === 0) return;
            
            carouselInner.style.transform = `translateX(-${currentSlide * 100}%)`;
            imageCounter.textContent = `${currentSlide + 1} / ${totalSlides}`;
            
            // Update active thumbnail
            document.querySelectorAll('.thumbnail').forEach((thumb, index) => {
                thumb.classList.toggle('active', index === currentSlide);
            });
        }

        function nextSlide() {
            if (totalSlides === 0) return;
            currentSlide = (currentSlide + 1) % totalSlides;
            updateCarousel();
        }

        function prevSlide() {
            if (totalSlides === 0) return;
            currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
            updateCarousel();
        }

        function goToSlide(index) {
            if (totalSlides === 0) return;
            currentSlide = index;
            updateCarousel();
        }

        // Keyboard Navigation
        document.addEventListener('keydown', (e) => {
            if (!galleryContent.classList.contains('visible')) return;
            if (totalSlides === 0) return;
            
            if (e.key === 'ArrowRight') {
                nextSlide();
            } else if (e.key === 'ArrowLeft') {
                prevSlide();
            } else if (e.key === 'Escape') {
                window.location.href = 'voyages.html';
            }
        });

        // Touch/Swipe Support
        let touchStartX = 0;
        let touchEndX = 0;

        carouselInner.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
        });

        carouselInner.addEventListener('touchend', (e) => {
            touchEndX = e.changedTouches[0].screenX;
            handleSwipe();
        });

        function handleSwipe() {
            if (totalSlides === 0) return;
            if (touchStartX - touchEndX > 50) {
                nextSlide();
            }
            if (touchEndX - touchStartX > 50) {
                prevSlide();
            }
        }
    </script>
</body>
</html>
